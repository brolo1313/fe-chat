# Dockerfile for local testing production build
# Production build with nginx, but for localhost URLs for OAuth

# ====== STAGE 1 — Build Angular ======
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build -- --configuration=local

# ====== STAGE 2 — Serve with Nginx ======
FROM nginx:1.25-alpine

COPY --from=builder /app/dist/fe-chat/browser /usr/share/nginx/html

# COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
